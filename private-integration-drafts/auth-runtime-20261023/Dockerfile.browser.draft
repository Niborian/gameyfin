# Reviewed browser transport only. Build context must be the repository root.
# No application build, modified application resources, mounts or new origins.
FROM ghcr.io/puppeteer/puppeteer:25.13.0@sha256:893118e0546f8cee371a0ae09c8489d1e9c40de28c45df9d811d4233203b81a3
LABEL org.gameyfin.browser.fixture="hosted-ci-only" org.gameyfin.browser.base-digest="sha256:893118e0546f8cee371a0ae09c8489d1e9c40de28c45df9d811d4233203b81a3" org.gameyfin.browser.auth-case="public-auth-case1-v1"
USER root
COPY --chown=pptruser:pptruser scripts/browser-benchmark/*.mjs /opt/gameyfin-browser/scripts/browser-benchmark/
COPY --chown=pptruser:pptruser private-integration-drafts/auth-runtime-20261023/browser_entry.draft.mjs private-integration-drafts/auth-runtime-20261023/case1_public_auth.mjs private-integration-drafts/auth-runtime-20261023/case1_protocol.mjs /opt/gameyfin-browser/private-integration-drafts/auth-runtime-20261023/
USER pptruser
ENV HOME=/home/pptruser
ENTRYPOINT ["node", "/opt/gameyfin-browser/private-integration-drafts/auth-runtime-20261023/browser_entry.draft.mjs"]
